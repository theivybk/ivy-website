---
export interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage: string;
  canonicalPath: string;
  jsonLd: Record<string, unknown>;
  active: 'home' | 'menu' | 'events' | 'careers' | 'none';
  navCtaLabel: string;
  navCtaHref: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  canonicalPath,
  jsonLd,
  active,
  navCtaLabel,
  navCtaHref,
} = Astro.props;

const canonicalUrl = `https://www.theivybk.com${canonicalPath}`;
const navLink = (href: string, key: typeof active, label: string) =>
  ({ href, label, cls: active === key ? 'active' : '' });

const navLinks = [
  navLink('/', 'home', 'Home'),
  navLink('/menu', 'menu', 'Menus'),
  navLink('/private-events', 'events', 'Private Events'),
  navLink('/careers', 'careers', 'Careers'),
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="google-site-verification" content="AK_GvcpLA7lvk5C7ZHNBof8xYQAt9hVfhL7D56S6dV4">
<script async src="https://www.googletagmanager.com/gtag/js?id=G-4JGELM7X23"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-4JGELM7X23');
</script>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalUrl}>
<meta property="og:type" content="restaurant">
<meta property="og:title" content={ogTitle ?? title}>
<meta property="og:description" content={ogDescription ?? description}>
<meta property="og:image" content={ogImage}>
<meta property="og:url" content={canonicalUrl}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle ?? title}>
<meta name="twitter:description" content={ogDescription ?? description}>
<meta name="twitter:image" content={ogImage}>
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<link rel="stylesheet" href="/assets/css/tokens.css">
<slot name="head" />
</head>
<body>

<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="ivy-leaf" viewBox="-50 -50 100 100">
      <path d="M 0,-46 C 2,-40 14,-32 16,-22 C 22,-20 32,-4 36,0 C 32,4 22,20 16,28 C 14,32 8,32 4,28 C 2,26 1,25 0,24 C -1,25 -2,26 -4,28 C -8,32 -14,32 -16,28 C -22,20 -32,4 -36,0 C -32,-4 -22,-20 -16,-22 C -14,-32 -2,-40 0,-46 Z" fill="currentColor"></path>
      <g stroke="rgba(0,0,0,.22)" stroke-width="1" fill="none" stroke-linecap="round">
        <path d="M 0,-40 L 0,26"></path>
        <path d="M 0,-14 L 18,-4"></path>
        <path d="M 0,-14 L -18,-4"></path>
        <path d="M 0,4 L 14,14"></path>
        <path d="M 0,4 L -14,14"></path>
      </g>
    </symbol>
    <symbol id="ivy-vine" viewBox="0 0 200 200">
      <path d="M 8,8 C 40,30 30,70 70,90 C 110,110 100,140 140,150 C 170,158 180,180 195,195" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity=".6"></path>
      <path d="M 70,90 C 90,70 110,72 130,55" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity=".55"></path>
      <path d="M 30,50 C 20,65 22,80 14,95" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity=".5"></path>
      <g>
        <use href="#ivy-leaf" x="18" y="18" width="34" height="34" transform="rotate(-30 18 18)"></use>
        <use href="#ivy-leaf" x="48" y="56" width="28" height="28" transform="rotate(40 48 56)"></use>
        <use href="#ivy-leaf" x="80" y="86" width="38" height="38" transform="rotate(-15 80 86)"></use>
        <use href="#ivy-leaf" x="120" y="48" width="26" height="26" transform="rotate(70 120 48)"></use>
        <use href="#ivy-leaf" x="118" y="118" width="32" height="32" transform="rotate(25 118 118)"></use>
        <use href="#ivy-leaf" x="150" y="148" width="36" height="36" transform="rotate(-40 150 148)"></use>
        <use href="#ivy-leaf" x="170" y="172" width="24" height="24" transform="rotate(15 170 172)"></use>
        <use href="#ivy-leaf" x="22" y="80" width="22" height="22" transform="rotate(-70 22 80)"></use>
      </g>
    </symbol>
    <symbol id="ivy-trail" viewBox="0 0 400 100">
      <path d="M 0,60 C 60,30 120,80 180,50 S 300,30 400,55" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".7"></path>
      <g>
        <use href="#ivy-leaf" x="44" y="40" width="26" height="26" transform="rotate(-20 44 40)"></use>
        <use href="#ivy-leaf" x="100" y="56" width="30" height="30" transform="rotate(45 100 56)"></use>
        <use href="#ivy-leaf" x="170" y="34" width="24" height="24" transform="rotate(-10 170 34)"></use>
        <use href="#ivy-leaf" x="240" y="52" width="28" height="28" transform="rotate(30 240 52)"></use>
        <use href="#ivy-leaf" x="320" y="36" width="26" height="26" transform="rotate(-30 320 36)"></use>
      </g>
    </symbol>
  </defs>
</svg>

<a href="#main-content" class="skip-link">Skip to main content</a>

<slot name="top" />

<header class="site-nav">
  <div class="wrap">
    <a href="/" class="brand"><img src="/assets/img/logo/logo-green.png" alt="The Ivy Bar and Kitchen" class="brand-logo" width="1492" height="1794"></a>
    <nav>
      {navLinks.map(l => <a href={l.href} class={l.cls}>{l.label}</a>)}
      <a href="/#specials">Specials</a>
      <a href="/#hours">Hours &amp; Location</a>
      <a href="/#contact">Contact</a>
    </nav>
    <a href="tel:+17737998160" class="nav-phone">(773) 799-8160</a>
    <a href={navCtaHref} class="btn btn--primary">{navCtaLabel}</a>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    {navLinks.map(l => <a href={l.href} class={l.cls}>{l.label}</a>)}
    <a href="/#specials">Specials</a>
    <a href="/#hours">Hours &amp; Location</a>
    <a href="/#contact">Contact</a>
    <a href="tel:+17737998160" class="mobile-phone">(773) 799-8160</a>
    <a href={navCtaHref} class="btn btn--primary mobile-cta">{navCtaLabel}</a>
  </div>
</header>

<main id="main-content"><slot /></main>

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <img src="/assets/img/logo/logo-gold.png" alt="The Ivy Bar and Kitchen" class="brand-logo-footer" width="1492" height="1794" loading="lazy">
        <p style="max-width:340px;">A classic neighborhood bar &amp; kitchen three blocks from Wrigley Field.</p>
      </div>
      <div>
        <h4>Visit</h4>
        <p>1625 W Irving Park Rd<br>Chicago, IL 60613</p>
        <p style="margin-top:12px;"><a href="tel:+17737998160">(773) 799-8160</a></p>
        <p><a href="mailto:info@theivybk.com">info@theivybk.com</a></p>
      </div>
      <div>
        <h4>Explore</h4>
        <p><a href="/">Home</a></p>
        <p><a href="/menu">Menus</a></p>
        <p><a href="/#specials">Specials</a></p>
        <p><a href="/private-events">Private Events</a></p>
        <p><a href="/careers">Careers</a></p>
        <p><a href="/#reserve">Reserve a Table</a></p>
      </div>
      <div>
        <h4>Stay in the Loop</h4>
        <p>Specials, game-day promos, and first word on private-event openings.</p>
        <form class="footer-newsletter-form" id="newsletter-form">
          <input type="email" id="newsletter-email" name="email" placeholder="you@email.com" required aria-label="Email address">
          <button type="submit" class="btn btn--brass-outline">Sign Up</button>
        </form>
        <p class="newsletter-note" id="newsletter-confirm"></p>
      </div>
    </div>
    <div class="bottom">
      <span>&copy; 2026 The Ivy Bar &amp; Kitchen</span>
      <span>Lakeview, Chicago</span>
    </div>
  </div>
</footer>

<script is:inline>
  const navToggle = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  navToggle.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', String(isOpen));
  });
  mobileMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    mobileMenu.classList.remove('open');
    navToggle.setAttribute('aria-expanded', 'false');
  }));

  const newsletterForm = document.getElementById('newsletter-form');
  newsletterForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('newsletter-email').value;
    const submitBtn = newsletterForm.querySelector('button[type="submit"]');
    const confirmEl = document.getElementById('newsletter-confirm');
    submitBtn.disabled = true;
    confirmEl.classList.remove('show', 'newsletter-error');

    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        confirmEl.textContent = data.alreadySubscribed
          ? "You're already on the list!"
          : "Thanks — we'll add you to the list.";
        confirmEl.classList.add('show');
        newsletterForm.reset();
      } else {
        confirmEl.textContent = data.error || 'Something went wrong — please try again.';
        confirmEl.classList.add('show', 'newsletter-error');
      }
    } catch {
      confirmEl.textContent = 'Something went wrong — please try again.';
      confirmEl.classList.add('show', 'newsletter-error');
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

</body>
</html>

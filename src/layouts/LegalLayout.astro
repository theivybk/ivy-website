---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  description: string;
  heading: string;
  canonicalPath: string;
  updated: string;
}

const { title, description, heading, canonicalPath, updated } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": heading,
  "url": `https://theivybk.com${canonicalPath}`,
  "isPartOf": {
    "@type": "WebSite",
    "name": "The Ivy Bar and Kitchen",
    "url": "https://theivybk.com"
  }
};
---
<Layout
  title={title}
  description={description}
  ogImage="https://theivybk.com/assets/img/gallery/DSC_1105.webp"
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  active="none"
  navCtaLabel="Reserve a Table"
  navCtaHref="/#reserve"
>
<section class="legal">
  <div class="wrap legal-wrap">
    <span class="eyebrow">Legal</span>
    <h1>{heading}</h1>
    <p class="legal-updated">Last updated {updated}</p>
    <slot />
  </div>
</section>
</Layout>

<style is:global>
  .legal { padding: var(--sp-10) var(--sp-5) var(--sp-11); }
  .legal .legal-wrap { max-width: 760px; margin: 0 auto; }
  .legal h1 { font-size: var(--fs-5xl); font-style: italic; margin: var(--sp-3) 0 var(--sp-3); }
  .legal .legal-updated { color: var(--fg-3); font-size: var(--fs-sm); margin: 0 0 var(--sp-8); }
  .legal h2 { font-size: var(--fs-2xl); font-style: italic; margin: var(--sp-8) 0 var(--sp-3); }
  .legal p, .legal li { color: var(--fg-2); line-height: 1.7; }
  .legal p { margin: 0 0 var(--sp-4); }
  .legal ul { margin: 0 0 var(--sp-4); padding-left: 20px; display: grid; gap: var(--sp-3); }
  .legal a { color: var(--ivy); border-bottom: 1px solid var(--brass); }
  @media (max-width: 860px) {
    .legal { padding: var(--sp-9) var(--sp-5) var(--sp-10); }
    .legal h1 { font-size: var(--fs-4xl); }
  }
</style>

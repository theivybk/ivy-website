---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["Restaurant", "BarOrPub"],
  "name": "The Ivy Bar and Kitchen",
  "url": "https://theivybk.com/bottles-to-go",
  "telephone": "+17737998160",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1625 W Irving Park Rd",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "postalCode": "60613",
    "addressCountry": "US"
  }
};

const categories = [
  {
    label: 'Bourbon',
    bottles: [
      { name: "Blanton's Single Barrel", size: '750ml', price: 105 },
      { name: 'Weller 12 Year', size: '1L', price: 80 },
      { name: 'Weller Full Proof', size: '750ml', price: 75 },
      { name: 'E.H. Taylor Small Batch', size: '750ml', price: 65 },
      { name: 'Eagle Rare 10 Year', size: '750ml', price: 55 },
      { name: 'Weller Special Reserve', size: '1L', price: 45 },
      { name: 'Buffalo Trace', size: '1L', price: 35 },
    ],
  },
  {
    label: 'Wine',
    bottles: [
      { name: 'Austin Hope Cabernet', size: '1L', price: 46 },
      { name: 'Maison Saint Aix Rosé', size: '750ml', price: 23 },
      { name: 'Rombauer Sauvignon Blanc', size: '750ml', price: 22 },
      { name: 'Raeburn Pinot Noir', size: '750ml', price: 19 },
      { name: 'Forever Summer Rosé', size: '750ml', price: 16 },
      { name: 'Flora Lisa Pinot Grigio', size: '750ml', price: 16 },
      { name: 'Liberty School Cabernet', size: '750ml', price: 16 },
      { name: 'Troublemaker Red Blend', size: '750ml', price: 16 },
      { name: 'Villa Maria Sauvignon Blanc', size: '750ml', price: 16 },
      { name: 'Barnard Griffin Chardonnay', size: '750ml', price: 15 },
      { name: 'Zardetto Spumante Brut', size: '750ml', price: 14 },
    ],
  },
];
---
<Layout
  title="Bottles To-Go | The Ivy Bar and Kitchen"
  description="Allocated bourbon and wine to take home from The Ivy Bar and Kitchen in Lakeview, Chicago: Blanton's, Weller, Eagle Rare and a short wine list, while supplies last."
  ogTitle="Bottles To-Go | The Ivy Bar and Kitchen"
  ogDescription="Allocated bourbon and wine to take home, while supplies last."
  ogImage="https://theivybk.com/assets/img/gallery/DSC_0648.webp"
  canonicalPath="/bottles-to-go"
  jsonLd={jsonLd}
  active="none"
  navCtaLabel="Reserve a Table"
  navCtaHref="/#reserve"
>
<Fragment slot="head">
  <meta name="robots" content="noindex, nofollow">
</Fragment>

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Take Home</span>
    <h1>Bottles To-Go</h1>
    <p>Allocated bourbon and a short wine list, ready to take home. Sold by the bottle, first come, first served.</p>
  </div>
</section>

<section class="bottles-section">
  <div class="wrap">
    {categories.map((cat) => (
      <div class="bottles-list">
        <h2 class="subhead">{cat.label}</h2>
        {cat.bottles.map((b) => (
          <div class="bottle-row">
            <span class="name">{b.name}<span class="size">{b.size}</span></span>
            <span class="leader"></span>
            <span class="price">${b.price}</span>
          </div>
        ))}
      </div>
    ))}
    <p class="bottles-note">Stock changes week to week. Must be 21 or older with valid ID — limit one bottle per customer while supplies last.</p>
  </div>
</section>

</Layout>

<style is:global>
  .page-hero {
    padding: var(--sp-9) 0 var(--sp-7); text-align: center;
    background: var(--bg-alt); border-bottom: 1px solid var(--border-hair);
  }
  .page-hero h1 { font-size: var(--fs-6xl); font-style: italic; margin-bottom: var(--sp-3); }
  .page-hero p { color: var(--fg-2); max-width: 480px; margin: 0 auto; }

  .bottles-section { padding: var(--sp-9) 0 var(--sp-11); text-align: center; }
  .bottles-list { max-width: 520px; margin: 0 auto var(--sp-8); text-align: left; }
  .bottles-list .subhead {
    font-family: var(--font-ui); font-size: var(--fs-2xs); font-weight: 600;
    letter-spacing: .18em; text-transform: uppercase; color: var(--ivy);
    margin: 0 0 var(--sp-3); padding-bottom: 6px; border-bottom: 1px solid var(--border-hair);
  }
  .bottle-row { display: flex; align-items: baseline; gap: 8px; padding: var(--sp-4) 0; border-bottom: 1px solid var(--border-hair); }
  .bottle-row .name { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); }
  .bottle-row .size { font-family: var(--font-ui); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--brass-deep); margin-left: 8px; }
  .bottle-row .leader { flex: 1; height: 1px; border-bottom: 1px dotted var(--border-strong); transform: translateY(-4px); min-width: 12px; }
  .bottle-row .price { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); color: var(--brass-deep); white-space: nowrap; }
  .bottles-note { max-width: 480px; margin: 0 auto var(--sp-6); color: var(--fg-2); font-size: var(--fs-sm); }

  @media (max-width: 640px) {
    .page-hero h1 { font-size: var(--fs-5xl); }
    .bottle-row .name { font-size: var(--fs-lg); }
    .bottle-row .price { font-size: var(--fs-lg); }
  }
</style>

---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["Restaurant", "BarOrPub"],
  "name": "The Ivy Bar and Kitchen",
  "url": "https://www.theivybk.com/careers",
  "telephone": "+17737998160",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1625 W Irving Park Rd",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "postalCode": "60613",
    "addressCountry": "US"
  },
  "areaServed": ["Lakeview, Chicago", "Wrigleyville, Chicago", "Chicago, IL"]
};
---
<Layout
  title="Careers | The Ivy Bar and Kitchen — Lakeview, Chicago"
  description="Now hiring for all positions at The Ivy Bar and Kitchen in Lakeview, Chicago — servers, bartenders, line cooks, hosts, and kitchen management. Apply today."
  ogTitle="Careers | The Ivy Bar and Kitchen"
  ogDescription="Now hiring for all positions. Join the team at The Ivy in Lakeview, Chicago."
  ogImage="https://www.theivybk.com/assets/img/gallery/DSC_1067.jpg"
  canonicalPath="/careers"
  jsonLd={jsonLd}
  active="careers"
  navCtaLabel="Reserve a Table"
  navCtaHref="/#reserve"
>
<Fragment slot="head">
  <link rel="preload" as="image" href="/assets/img/gallery/DSC_1067.jpg" fetchpriority="high">
</Fragment>

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--brass-light)">Careers</span>
    <h1>Join the team.</h1>
    <p>We're currently hiring for all positions — front of house, back of house, and everything in between. If you take pride in good work, we want to meet you.</p>
  </div>
</section>

<section class="roles">
  <div class="wrap">
    <div class="section-head" style="text-align:center; margin-bottom:var(--sp-8);">
      <span class="eyebrow">Open Roles</span>
      <h2 style="font-size:var(--fs-4xl); font-style:italic;">Now hiring</h2>
    </div>
    <div class="roles-grid">
      <div class="role-card">
        <h3>Servers</h3>
        <p>Full-time &amp; part-time. Experience preferred but not required — we train the right attitude.</p>
      </div>
      <div class="role-card">
        <h3>Bartenders</h3>
        <p>Cocktail and beer program experience a plus. Rooftop and main bar shifts available.</p>
      </div>
      <div class="role-card">
        <h3>Line Cooks</h3>
        <p>Pizza and kitchen line experience preferred. Fast-paced, high-volume environment.</p>
      </div>
      <div class="role-card">
        <h3>Hosts</h3>
        <p>First point of contact for every guest. Friendly, organized, and unbothered by a packed room on game day.</p>
      </div>
      <div class="role-card">
        <h3>Barbacks</h3>
        <p>Support the bar team during peak service — great entry point into the industry.</p>
      </div>
      <div class="role-card">
        <h3>Kitchen Management</h3>
        <p>Experienced kitchen leaders — help run the line, manage inventory, and train the team.</p>
      </div>
    </div>
  </div>
</section>

<section class="why-work">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--brass-light)">Why Work Here</span>
    <h2 style="color:var(--cream); font-style:italic;">A team that treats you like family</h2>
    <div class="why-work-grid">
      <div>
        <h3>Flexible Scheduling</h3>
        <p>We work around school, family, and everything else life throws at you.</p>
      </div>
      <div>
        <h3>Real Growth</h3>
        <p>From barback to bartender, server to manager — we promote from within.</p>
      </div>
      <div>
        <h3>A Room Worth Working</h3>
        <p>A rooftop, a real kitchen, and a neighborhood crowd that knows your name too.</p>
      </div>
    </div>
  </div>
</section>

<section class="form-section" id="apply">
  <div class="wrap form-wrap">
    <div class="section-head">
      <span class="eyebrow">Apply Now</span>
      <h2>Tell us about yourself</h2>
      <p>Fill this out and we'll follow up to schedule an interview. Have a resume? Attach it to the email that opens after you submit.</p>
    </div>

    <form class="apply-form" id="apply-form" data-recipient="info@theivybk.com">
      <div class="form-row">
        <div class="field">
          <label for="a-name">Full Name<span class="req">*</span></label>
          <input type="text" id="a-name" name="full_name" required autocomplete="name">
        </div>
        <div class="field">
          <label for="a-phone">Phone<span class="req">*</span></label>
          <input type="tel" id="a-phone" name="phone" required autocomplete="tel">
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="a-email">Email<span class="req">*</span></label>
          <input type="email" id="a-email" name="email" required autocomplete="email">
        </div>
        <div class="field">
          <label for="a-position">Position<span class="req">*</span></label>
          <select id="a-position" name="position" required>
            <option value="">Select a role</option>
            <option>Server</option>
            <option>Bartender</option>
            <option>Line Cook</option>
            <option>Host</option>
            <option>Barback</option>
            <option>Kitchen Management</option>
            <option>Other</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="a-availability">Availability<span class="req">*</span></label>
          <select id="a-availability" name="availability" required>
            <option value="">Select</option>
            <option>Full-time</option>
            <option>Part-time</option>
            <option>Weekends only</option>
            <option>Flexible</option>
          </select>
        </div>
        <div class="field">
          <label for="a-experience">Years of Experience <span style="font-weight:400; text-transform:none; color:var(--fg-3);">(optional)</span></label>
          <input type="text" id="a-experience" name="experience" placeholder="e.g. 2 years">
        </div>
      </div>
      <div class="form-row single">
        <div class="field">
          <label for="a-message">Tell Us About Yourself <span style="font-weight:400; text-transform:none; color:var(--fg-3);">(optional)</span></label>
          <textarea id="a-message" name="message" placeholder="Relevant experience, availability details, anything else we should know."></textarea>
        </div>
      </div>
      <div class="submit-row">
        <button type="submit" class="btn btn--primary">Submit Application</button>
        <p class="submit-note">Applications are sent to <a href="mailto:info@theivybk.com" style="border-bottom:1px solid var(--brass);">info@theivybk.com</a> — we'll follow up within a few days.</p>
      </div>
    </form>

    <div class="form-confirm" id="apply-confirm" hidden>
      <h2>Got it.</h2>
      <p>Your application is on its way to our hiring team. If your email client didn't open automatically, attach your resume and send it directly to <a href="mailto:info@theivybk.com" style="border-bottom:1px solid var(--brass);">info@theivybk.com</a>.</p>
    </div>
  </div>
</section>

<script is:inline>
  const applyForm = document.getElementById('apply-form');
  applyForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(applyForm);
    const label = (v) => v && v.trim() ? v : '—';
    const lines = [
      `Name: ${label(data.get('full_name'))}`,
      `Phone: ${label(data.get('phone'))}`,
      `Email: ${label(data.get('email'))}`,
      `Position: ${label(data.get('position'))}`,
      `Availability: ${label(data.get('availability'))}`,
      `Experience: ${label(data.get('experience'))}`,
      ``,
      `Message:`,
      label(data.get('message'))
    ].join('\n');
    const subject = `Job Application — ${label(data.get('position'))} — ${label(data.get('full_name'))}`;
    const mailto = `mailto:${applyForm.dataset.recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines)}`;
    window.location.href = mailto;

    applyForm.hidden = true;
    document.getElementById('apply-confirm').hidden = false;
    document.getElementById('apply-confirm').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>
</Layout>

<style is:global>
  .page-hero {
    position: relative; padding: var(--sp-11) 0 var(--sp-9); text-align: center; color: var(--cream);
    background: linear-gradient(180deg, rgba(22,48,31,.55), rgba(22,48,31,.88)),
                url('/assets/img/gallery/DSC_1067.jpg') center/cover no-repeat;
  }
  .page-hero h1 { color: var(--cream); font-size: var(--fs-6xl); font-style: italic; margin-bottom: var(--sp-4); }
  .page-hero p { max-width: 560px; margin: 0 auto; color: rgba(245,239,227,.88); }

  .roles { padding: var(--sp-11) 0; }
  .roles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-6); }
  .role-card {
    background: var(--bg-card); border: 1px solid var(--border-hair); border-radius: var(--r-sm);
    padding: var(--sp-7); text-align: center;
  }
  .role-card h3 { font-size: var(--fs-xl); margin-bottom: var(--sp-3); }
  .role-card p { color: var(--fg-2); font-size: var(--fs-sm); margin: 0; }
  @media (max-width: 860px) { .roles-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .roles-grid { grid-template-columns: 1fr; } }

  .why-work { padding: var(--sp-9) 0; background: var(--bg-inverse); color: var(--cream); text-align: center; }
  .why-work-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--sp-7); margin-top: var(--sp-7); text-align: left; }
  .why-work-grid h3 { color: var(--cream); font-size: var(--fs-xl); }
  .why-work-grid p { color: rgba(245,239,227,.8); font-size: var(--fs-sm); margin: 0; }
  @media (max-width: 860px) { .why-work-grid { grid-template-columns: 1fr; } }

  .form-section { padding: var(--sp-11) 0; }
  .form-wrap { max-width: 640px; margin: 0 auto; }
  .form-wrap .section-head { text-align: center; margin-bottom: var(--sp-7); }
  .form-wrap .section-head h2 { font-size: var(--fs-4xl); font-style: italic; }
  .form-wrap .section-head p { color: var(--fg-2); font-size: var(--fs-sm); }
  form.apply-form { background: var(--bg-card); border: 1px solid var(--border-hair); border-radius: var(--r-sm); padding: var(--sp-8); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-5); margin-bottom: var(--sp-5); }
  .form-row.single { grid-template-columns: 1fr; }
  .field label {
    display: block; font-family: var(--font-ui); font-size: var(--fs-2xs); font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase; color: var(--ivy); margin-bottom: var(--sp-2);
  }
  .field .req { color: var(--brick); margin-left: 2px; }
  .field input, .field select, .field textarea {
    width: 100%; font-family: var(--font-body); font-size: var(--fs-md); color: var(--ink);
    background: var(--cream-pure); border: 1px solid var(--border-hair); border-radius: var(--r-xs);
    padding: 12px 14px;
  }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--ivy); }
  .field textarea { resize: vertical; min-height: 100px; }
  .submit-row { text-align: center; margin-top: var(--sp-7); }
  .submit-row .btn { width: 100%; justify-content: center; padding: 16px; font-size: var(--fs-sm); }
  .submit-note { text-align: center; font-size: 12px; color: var(--fg-3); margin-top: var(--sp-4); }
  .form-confirm { background: var(--bg-card); border: 1px solid var(--border-hair); border-radius: var(--r-sm); padding: var(--sp-8); text-align: center; }
  .form-confirm h2 { font-style: italic; font-size: var(--fs-4xl); }
  .form-confirm p { color: var(--fg-2); margin: 0; }

  @media (max-width: 860px) { .form-row { grid-template-columns: 1fr; } }
</style>

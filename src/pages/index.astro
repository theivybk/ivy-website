<script is:inline>
  const reserveForm = document.getElementById('reserve-form');

  const dateInput = document.getElementById('r-date');
  const sameDayNotice = document.getElementById('same-day-notice');
  const submitRow = document.getElementById('submit-row');
  const todayStr = () => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  };
  const updateSameDayState = () => {
    const isToday = dateInput.value === todayStr();
    sameDayNotice.hidden = !isToday;
    submitRow.hidden = isToday;
  };
  dateInput.addEventListener('change', updateSameDayState);
  updateSameDayState();

  reserveForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(reserveForm);
    const payload = Object.fromEntries(data.entries());
    const submitBtn = reserveForm.querySelector('button[type="submit"]');
    const errorEl = document.getElementById('reserve-error');
    submitBtn.disabled = true;
    errorEl.hidden = true;

    try {
      const res = await fetch('/api/reserve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await res.json();
      if (res.ok && result.ok) {
        const dateVal = payload.date ? new Date(payload.date + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) : 'you soon';
        document.getElementById('reserve-confirm-text').textContent = `We'll see you ${dateVal}${payload.time ? ' at ' + payload.time : ''}. A confirmation will follow by phone or email.`;
        reserveForm.hidden = true;
        document.getElementById('reserve-confirm').hidden = false;
        document.getElementById('reserve-confirm').scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        errorEl.textContent = result.error || 'Something went wrong — please try again or call us.';
        errorEl.hidden = false;
      }
    } catch {
      errorEl.textContent = 'Something went wrong — please try again or call us.';
      errorEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
</Layout>


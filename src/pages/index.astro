---
import Layout from '../layouts/Layout.astro';

const restaurantLd = {
  "@type": ["Restaurant", "BarOrPub"],
  "name": "The Ivy Bar and Kitchen",
  "alternateName": "The Ivy",
  "description": "A neighborhood bar & restaurant in Lakeview, Chicago, three blocks from Wrigley Field, serving Chicago Tavern & Detroit Pan pizza, smash burgers, and craft cocktails, with rooftop and private event space. A go-to spot before Cubs games and Wrigley Field concerts, with TVs throughout the bar, dining room, and rooftop.",
  "image": [
    "https://theivybk.com/assets/img/gallery/DSC_1103.jpg",
    "https://theivybk.com/assets/img/gallery/DSC_0785.jpg",
    "https://theivybk.com/assets/img/gallery/DSC_0774.jpg"
  ],
  "url": "https://theivybk.com/",
  "telephone": "+17737998160",
  "priceRange": "$$",
  "servesCuisine": ["American", "Pizza", "Bar Food"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1625 W Irving Park Rd",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "postalCode": "60613",
    "addressCountry": "US"
  },
  "areaServed": ["Lakeview, Chicago", "Wrigleyville, Chicago", "Chicago, IL"],
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday"], "opens": "15:00", "closes": "23:59" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Thursday", "opens": "11:00", "closes": "23:59" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Friday", "Saturday"], "opens": "11:00", "closes": "01:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "11:00", "closes": "23:59" }
  ],
  "menu": "https://theivybk.com/menu",
  "acceptsReservations": "True",
  "sameAs": [
    "https://www.instagram.com/theivybk/",
    "https://www.facebook.com/p/The-Ivy-Bar-and-Kitchen-61587359361446/"
  ],
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "Rooftop Seating", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Private Event Space", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Outdoor Seating", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Full Bar", "value": true }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "28"
  }
};

const faqLd = {
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you take reservations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We hold a mix of reservations and walk-in seating at the bar and in the dining room. Request a table on our homepage or call us at (773) 799-8160 — recommended for parties of six or more and game-day visits. Note: on the rooftop, we can't combine tables for groups larger than 4, so larger rooftop parties may be split across nearby tables."
      }
    },
    {
      "@type": "Question",
      "name": "Is there parking near the restaurant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Street parking is available along Irving Park Rd and the surrounding side streets. On Cubs game days, we recommend budgeting extra time or using rideshare."
      }
    },
    {
      "@type": "Question",
      "name": "Do you have gluten-free or vegetarian options?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — a dedicated gluten-free beer selection, a Beyond patty swap on any burger, and vegetarian-friendly items across the menu including our White Out pizza and House Salad."
      }
    },
    {
      "@type": "Question",
      "name": "What kind of pizza do you have?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Two styles, made fresh to order — Chicago Tavern (thin, crisp, cut in squares) and Detroit Pan (golden crust, crispy corners) — plus a build-your-own option where you pick the crust, sauce, and toppings."
      }
    },
    {
      "@type": "Question",
      "name": "Is The Ivy a good spot before a Cubs game or a Wrigley Field concert?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — we're three blocks from Wrigley Field with TVs throughout the bar, dining room, and rooftop. Grab pizza and a drink before first pitch, or come by after the show. Reservations are recommended on game days and concert nights since we fill up fast."
      }
    },
    {
      "@type": "Question",
      "name": "Can kids eat here?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We have a full kids menu for guests twelve and under, plus activity pages to keep them busy while the food comes out."
      }
    },
    {
      "@type": "Question",
      "name": "Is the rooftop 21 and over?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — our rooftop bar is 21+. The main dining room and downstairs bar welcome all ages."
      }
    },
    {
      "@type": "Question",
      "name": "How do I book a private event?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Head to our Private Events page and fill out the inquiry form — our events team follows up within one business day with availability and pricing."
      }
    },
    {
      "@type": "Question",
      "name": "Are you hiring?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We're currently hiring. Visit our Careers page to apply."
      }
    }
  ]
};

const triviaLd = {
  "@type": "Event",
  "name": "Trivia Night at The Ivy",
  "description": "Weekly trivia night hosted by Geeks Who Drink at The Ivy Bar and Kitchen.",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "startDate": "2026-08-26T19:00-05:00",
  "endDate": "2026-08-26T21:00-05:00",
  "eventSchedule": {
    "@type": "Schedule",
    "repeatFrequency": "P1W",
    "byDay": "https://schema.org/Wednesday",
    "startTime": "19:00",
    "endTime": "21:00",
    "startDate": "2026-08-26"
  },
  "location": {
    "@type": "Place",
    "name": "The Ivy Bar and Kitchen",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1625 W Irving Park Rd",
      "addressLocality": "Chicago",
      "addressRegion": "IL",
      "postalCode": "60613",
      "addressCountry": "US"
    }
  },
  "organizer": { "@type": "Organization", "name": "Geeks Who Drink" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" }
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [restaurantLd, faqLd, triviaLd]
};
---
<Layout
  title="The Ivy Bar and Kitchen | Bar & Restaurant in Lakeview, Chicago, IL"
  description="Neighborhood bar & restaurant in Lakeview, Chicago, IL, three blocks from Wrigley Field — Chicago Tavern & Detroit Pan pizza, rooftop seating & craft cocktails."
  ogImage="https://theivybk.com/assets/img/gallery/DSC_1105.jpg"
  canonicalPath="/"
  jsonLd={jsonLd}
  active="home"
  navCtaLabel="Reserve a Table"
  navCtaHref="#reserve"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/img/gallery/DSC_1105.jpg" fetchpriority="high">
  </Fragment>

<section class="hero">
  <div class="wrap hero-inner">
    <span class="eyebrow">Lakeview · Chicago</span>
    <h1>Three blocks from Wrigley, Chicago's hometown restaurant for everyone.</h1>
    <p class="lead">Fine drinks, Chicago Tavern &amp; Detroit Pan pizzas, and the kind of burgers that end the debate. Now open on Irving Park.</p>
    <div class="cta-row">
      <a href="#reserve" class="btn btn--primary">Reserve a Table</a>
      <a href="/menu" class="btn btn--brass-outline">View Menus</a>
      <a href="https://order.toasttab.com/online/the-ivy-1625-west-irving-park-road" class="btn btn--brass-outline">Order Online</a>
      <a href="/private-events" class="btn btn--brass-outline">Plan an Event</a>
    </div>
  </div>
</section>

<section class="reserve-section" id="reserve">
  <div class="wrap reserve-wrap">
    <div class="section-head">
      <span class="eyebrow">Book a Table</span>
      <h2>Reserve your spot</h2>
      <p>We hold a mix of reservations and walk-in seating. Send us your details and we'll confirm by phone or email.</p>
    </div>

    <form class="reserve-form" id="reserve-form">
      <div class="form-row">
        <div class="field">
          <label for="r-name">Full Name<span class="req">*</span></label>
          <input type="text" id="r-name" name="full_name" required autocomplete="name">
        </div>
        <div class="field">
          <label for="r-phone">Phone<span class="req">*</span></label>
          <input type="tel" id="r-phone" name="phone" required autocomplete="tel">
        </div>
      </div>
      <div class="form-row single">
        <div class="field">
          <label for="r-email">Email<span class="req">*</span></label>
          <input type="email" id="r-email" name="email" required autocomplete="email">
        </div>
      </div>
      <div class="form-row triple">
        <div class="field">
          <label for="r-date">Date<span class="req">*</span></label>
          <input type="date" id="r-date" name="date" required>
        </div>
        <div class="field">
          <label for="r-time">Time<span class="req">*</span></label>
          <select id="r-time" name="time" required>
            <option value="">Select</option>
            <option>11:00 AM</option><option>11:30 AM</option><option>12:00 PM</option><option>12:30 PM</option>
            <option>1:00 PM</option><option>1:30 PM</option><option>2:00 PM</option><option>2:30 PM</option>
            <option>3:00 PM</option><option>3:30 PM</option><option>4:00 PM</option><option>4:30 PM</option>
            <option>5:00 PM</option><option>5:30 PM</option><option>6:00 PM</option><option>6:30 PM</option>
            <option>7:00 PM</option><option>7:30 PM</option><option>8:00 PM</option><option>8:30 PM</option>
            <option>9:00 PM</option><option>9:30 PM</option><option>10:00 PM</option>
          </select>
        </div>
        <div class="field">
          <label for="r-party">Party Size<span class="req">*</span></label>
          <select id="r-party" name="party_size" required>
            <option value="">Select</option>
            <option>1</option><option>2</option><option>3</option><option>4</option>
            <option>5</option><option>6</option><option>7</option><option>8</option><option>9+</option>
          </select>
        </div>
      </div>
      <div class="form-row single">
        <div class="field">
          <label for="r-notes">Special Requests <span style="font-weight:400; text-transform:none; color:var(--fg-3);">(optional)</span></label>
          <textarea id="r-notes" name="notes" placeholder="Allergies, seating preference, occasion — anything we should know."></textarea>
        </div>
      </div>
      <p class="party-note">On the rooftop, we're unable to combine tables for more than 4 guests — larger rooftop parties may be seated at separate nearby tables. Party of 9 or more? Head to our <a href="/private-events" style="border-bottom:1px solid var(--brass);">Private Events</a> page instead.</p>
      <div class="same-day-notice" id="same-day-notice" hidden>
        <p>Need a table <strong>today</strong>? Email requests may not reach us in time — call and we'll take care of you directly.</p>
        <a href="tel:+17737998160" class="btn btn--primary">Call (773) 799-8160</a>
      </div>
      <div class="submit-row" id="submit-row">
        <button type="submit" class="btn btn--primary">Request Reservation</button>
        <p class="submit-note">Requests are sent to <a href="mailto:info@theivybk.com" style="border-bottom:1px solid var(--brass);">info@theivybk.com</a> — we'll confirm by phone or email.</p>
        <p class="submit-error" id="reserve-error" hidden></p>
      </div>
    </form>

    <div class="form-confirm" id="reserve-confirm" hidden>
      <h2>Booked.</h2>
      <p id="reserve-confirm-text">We'll see you soon — a confirmation will follow by phone or email.</p>
    </div>
  </div>
</section>

<section class="about">
  <div class="wrap about-grid">
    <img src="/assets/img/gallery/ivy-sign-exterior.jpg" alt="The Ivy Bar and Kitchen storefront sign in Lakeview, Chicago" width="1024" height="683" loading="lazy">
    <div class="about-copy">
      <span class="eyebrow">Our Story</span>
      <h2>Sports bar, redefined. Comfort, elevated.</h2>
      <p class="lede">We opened The Ivy because Lakeview needed a room that does both — first pitch on every screen, and a kitchen that actually earns your order.</p>
      <p>A neighborhood bar &amp; kitchen where the Chicago Tavern pizza is thin and cut in squares, the burgers are smashed to order, and the person pouring your Old Fashioned actually knows what's in it. We're three blocks from the ivy on Waveland, and we borrowed the name honestly.</p>
      <p>Whether you're in for a pint before first pitch or booking one of our event spaces for a rehearsal dinner, we run this place the way a neighborhood spot should be run: good food, a real bar, and a host who remembers your name by the second visit.</p>
      <a href="/private-events" class="btn btn--ghost">Meet the Team &amp; Book an Event</a>
    </div>
  </div>
</section>

<section class="features">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">What We Do</span>
      <h2>A neighborhood bar &amp; kitchen, done right</h2>
    </div>
    <div class="feature-grid">
      <div class="feature-card">
        <h3>Fine Drinks</h3>
        <p>Carefully crafted cocktails, a real wine list, and a deep bench of whiskey, tequila &amp; mezcal.</p>
      </div>
      <div class="feature-card">
        <h3>Specialty Pizzas</h3>
        <p>Chicago Tavern and Detroit Pan, by the pie or built your own — pick a crust, a sauce, and go.</p>
      </div>
      <div class="feature-card">
        <h3>Delicious Bites</h3>
        <p>Smash burgers, hand-breaded tenders, and the kind of sandwiches that make game day.</p>
      </div>
    </div>
  </div>
</section>

<section class="gameday-teaser" id="gameday">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--brass-light)">Game Day &amp; Concert Nights</span>
    <h2>Three blocks from Wrigley Field</h2>
    <p>Catch the game or grab a bite before the show — TVs throughout the bar, dining room, and rooftop, plus Chicago Tavern &amp; Detroit Pan pizza, smash burgers, and drinks to fuel the walk over. Reserve ahead on game days and concert nights, since we fill up fast.</p>
    <div class="gameday-ctas">
      <a href="#reserve" class="btn btn--primary">Reserve a Table</a>
      <a href="/menu" class="btn btn--brass-outline">View Menus</a>
    </div>
  </div>
</section>

<section class="specials" id="specials">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Every Week</span>
      <h2>The Ivy specials</h2>
      <p>Four nights, four reasons to come back — plus happy hour all week long.</p>
    </div>
    <div class="specials-grid">
      <div class="specials-card">
        <span class="specials-day">Monday</span>
        <h3>Monday Night Pizza</h3>
        <p>Half off pizza with the purchase of a drink</p>
        <p class="specials-note">*Dine-in only</p>
      </div>
      <div class="specials-card">
        <span class="specials-day">Tuesday</span>
        <h3>Taco Tuesday</h3>
        <p>$3 tacos · $6 Modelos · $9 margaritas</p>
        <p class="specials-note">*Dine-in only</p>
      </div>
      <div class="specials-card">
        <span class="specials-day">Wednesday</span>
        <h3>Burger &amp; Brew</h3>
        <p>Burger and beer combo, $20</p>
        <p class="specials-note">*Dine-in only</p>
      </div>
      <div class="specials-card">
        <span class="specials-day">Thursday</span>
        <h3>Girl Dinner Thursday</h3>
        <p>Salad, truffle fries &amp; a glass of wine, $30</p>
        <p class="specials-note">*Select wines · Dine-in only</p>
      </div>
    </div>
    <div class="happy-hour-bar">
      <div>
        <span class="eyebrow" style="color:var(--brass-light)">Happy Hour</span>
        <h3>Monday – Thursday <span class="hh-time">· 3pm – 5pm</span></h3>
      </div>
      <p>$1 off draft, cans &amp; bottles &nbsp;·&nbsp; $2 off wine &nbsp;·&nbsp; $3 off cocktails</p>
    </div>
    <p class="specials-footnote">Add-ons subject to extra charge</p>
  </div>
</section>

<section class="trivia-teaser" id="trivia">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--brass-light)">Every Wednesday</span>
    <h2>Trivia Night</h2>
    <p>7&ndash;9pm &mdash; starting August 26.</p>
    <img src="/assets/img/partners/geeks-who-drink.png" alt="Hosted by Geeks Who Drink" class="trivia-host-logo" width="600" height="234" loading="lazy">
    <a href="#reserve" class="btn btn--brass-outline">Reserve a Table</a>
  </div>
</section>

<section class="order-direct" id="order">
  <div class="wrap">
    <div>
      <h2>Order direct, skip the fees</h2>
      <p>Order online for pickup or delivery, or call it in — either way you skip the third-party markup, more of every dollar stays in the neighborhood, and your order gets to the kitchen faster.</p>
    </div>
    <div class="order-direct-ctas">
      <div class="order-direct-ctas-row">
        <a href="https://order.toasttab.com/online/the-ivy-1625-west-irving-park-road" class="btn btn--primary">Order Online</a>
        <a href="tel:+17737998160" class="btn btn--ghost">Call to Order</a>
      </div>
      <p class="order-direct-note">You'll complete your order securely with Toast, our ordering &amp; payment partner. <a href="https://www.toasttab.com/the-ivy-1625-west-irving-park-road/giftcards" style="border-bottom:1px solid var(--brass);">Gift cards also available</a>.</p>
    </div>
  </div>
</section>

<section class="gallery-strip">
  <div class="strip-grid">
    <a href="/assets/img/gallery/DSC_1103.jpg"><img src="/assets/img/gallery/DSC_1103.jpg" alt="The Ivy rooftop bar, second-floor" width="1024" height="684" loading="lazy"></a>
    <a href="/assets/img/gallery/DSC_0954.jpg"><img src="/assets/img/gallery/DSC_0954.jpg" alt="The Ivy rooftop bar taps" width="1024" height="1475" loading="lazy"></a>
    <a href="/assets/img/gallery/DSC_0785.jpg"><img src="/assets/img/gallery/DSC_0785.jpg" alt="The Ivy rooftop patio seating" width="1024" height="683" loading="lazy"></a>
    <a href="/assets/img/gallery/DSC_0648.jpg"><img src="/assets/img/gallery/DSC_0648.jpg" alt="Craft cocktail at The Ivy" width="1024" height="1438" loading="lazy"></a>
    <a href="/assets/img/gallery/DSC_0740.jpg"><img src="/assets/img/gallery/DSC_0740.jpg" alt="Craft cocktail at The Ivy" width="1024" height="683" loading="lazy"></a>
    <a href="/assets/img/gallery/DSC_1067.jpg"><img src="/assets/img/gallery/DSC_1067.jpg" alt="The Ivy team outside the restaurant" width="1024" height="648" loading="lazy"></a>
  </div>
</section>

<section class="instagram-feed">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">@theivybk</span>
      <h2>Follow along</h2>
      <p>Sports Bar Redefined. Comfort, Elevated. — the latest from our rooftop, our kitchen, and our bar.</p>
    </div>
    <div class="ig-grid">
      <a href="https://www.instagram.com/theivybk/"><img src="/assets/img/gallery/DSC_0563.jpg" alt="Craft beer taps at The Ivy" width="1024" height="604" loading="lazy"></a>
      <a href="https://www.instagram.com/theivybk/"><img src="/assets/img/gallery/DSC_0629.jpg" alt="Margarita at The Ivy" width="1024" height="1563" loading="lazy"></a>
      <a href="https://www.instagram.com/theivybk/"><img src="/assets/img/gallery/DSC_0585.jpg" alt="Lychee martini at The Ivy" width="1024" height="1501" loading="lazy"></a>
      <a href="https://www.instagram.com/theivybk/"><img src="/assets/img/gallery/DSC_0999.jpg" alt="Rooftop patio table at The Ivy" width="1024" height="683" loading="lazy"></a>
    </div>
    <div class="ig-handle">
      <a href="https://www.instagram.com/theivybk/">Follow @theivybk on Instagram</a>
      <span style="margin:0 8px; color:var(--fg-3);">&middot;</span>
      <a href="https://www.facebook.com/p/The-Ivy-Bar-and-Kitchen-61587359361446/">Follow us on Facebook</a>
    </div>
  </div>
</section>

<section class="reviews">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">From the Neighborhood</span>
      <h2>What guests are saying</h2>
      <a class="rating-badge" href="https://www.google.com/maps?cid=15165809700464267913">
        <span class="stars">★★★★★</span>
        <span class="rating-value">4.9</span>
        <span class="rating-count">(28 Google reviews)</span>
      </a>
    </div>
    <div class="review-grid">
      <div class="review-card">
        <div class="stars">★★★★★</div>
        <p>"Great staff, food, and drinks. The burgers were tasty and well prepared, as were the sides — in particular the green beans were excellent."</p>
        <div class="who">— Frank D.</div>
      </div>
      <div class="review-card">
        <div class="stars">★★★★★</div>
        <p>"A shaded patio and a lychee martini — along with a bonus lychee mojito and a robust mocktail menu — served by friendly staff and owners."</p>
        <div class="who">— Melanie K.</div>
      </div>
      <div class="review-card">
        <div class="stars">★★★★★</div>
        <p>"Pushing back against the scourge of mediocre sports-bar food" — with a second-floor rooftop that's rare for a Lakeview-area sports bar.</p>
        <div class="who">— The Infatuation, Chicago</div>
      </div>
    </div>
  </div>
</section>

<section class="events-teaser">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--brass-light)">Private Events</span>
    <h2>Book the room. We'll handle the rest.</h2>
    <p>Birthdays, showers, rehearsal dinners, corporate happy hours &amp; game-day watch parties — including our second-floor rooftop, one of the only ones of its kind in this stretch of Lakeview.</p>
    <a href="/private-events" class="btn btn--brass-outline">Start an Inquiry</a>
  </div>
</section>

<section class="hours-loc" id="hours">
  <div class="wrap hl-grid">
    <div>
      <span class="eyebrow">Hours</span>
      <h2 style="margin-top:8px;">When to find us</h2>
      <table class="hours-table">
        <tr><td><span class="status-dot"></span>Monday</td><td>3pm – 12am</td></tr>
        <tr><td><span class="status-dot"></span>Tuesday</td><td>3pm – 12am</td></tr>
        <tr><td><span class="status-dot"></span>Wednesday</td><td>3pm – 12am</td></tr>
        <tr><td><span class="status-dot"></span>Thursday</td><td>11am – 12am</td></tr>
        <tr><td><span class="status-dot"></span>Friday</td><td>11am – 1am</td></tr>
        <tr><td><span class="status-dot"></span>Saturday</td><td>11am – 1am</td></tr>
        <tr><td><span class="status-dot"></span>Sunday</td><td>11am – 12am</td></tr>
      </table>
    </div>
    <div id="contact">
      <span class="eyebrow">Location</span>
      <h2 style="margin-top:8px;">1625 W Irving Park Rd</h2>
      <div class="addr-block">
        <p>1625 W Irving Park Rd, Chicago, IL 60613</p>
        <p><a href="tel:+17737998160" style="border-bottom:1px solid var(--brass);">(773) 799-8160</a></p>

---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["Restaurant", "BarOrPub"],
  "name": "The Ivy Bar and Kitchen",
  "url": "https://theivybk.com/private-events",
  "telephone": "+17737998160",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1625 W Irving Park Rd",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "postalCode": "60613",
    "addressCountry": "US"
  },
  "areaServed": ["Lakeview, Chicago", "Wrigleyville, Chicago", "Chicago, IL"],
  "sameAs": [
    "https://www.instagram.com/theivybk/",
    "https://www.facebook.com/p/The-Ivy-Bar-and-Kitchen-61587359361446/"
  ],
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "Rooftop Seating", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Private Event Space", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Full Venue Buyout", "value": true }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "28"
  }
};
---
<Layout
  title="Private Event Space | The Ivy Bar and Kitchen — Lakeview, Chicago"
  description="Private event space in Lakeview, Chicago — rooftop, dedicated event space & dining room buyouts for birthdays, showers, rehearsal dinners & corporate events."
  ogTitle="Private Event Space | The Ivy Bar and Kitchen — Lakeview, Chicago"
  ogDescription="Book the room. We'll handle the rest. Rooftop and private event space at The Ivy in Lakeview, Chicago."
  ogImage="https://theivybk.com/assets/img/gallery/DSC_1103.jpg"
  canonicalPath="/private-events"
  jsonLd={jsonLd}
  active="events"
  navCtaLabel="Start an Inquiry"
  navCtaHref="#inquiry"
>
<Fragment slot="head">
  <link rel="preload" as="image" href="/assets/img/gallery/DSC_1103.jpg" fetchpriority="high">
</Fragment>

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--brass-light)">Private Events</span>
    <h1>Book the room.<br>We'll handle the rest.</h1>
    <p>Whether it's a birthday, a baby shower, an office happy hour, or a game-day watch party — tell us what you're planning and we'll build it around you. Our second-floor rooftop is one of the only ones of its kind on this stretch of Lakeview.</p>
  </div>
</section>

<section class="occasions">
  <div class="wrap">
    <div class="occ-grid">
      <div>Birthdays</div><div>Anniversaries</div><div>Baby &amp; Bridal Showers</div><div>Bachelor/Bachelorette</div>
      <div>Rehearsal Dinners</div><div>Graduations</div><div>Corporate Events</div><div>Holiday Parties</div>
    </div>
  </div>
</section>

<section class="spaces">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Our Spaces</span>
      <h2>Five ways to host</h2>
      <p>From an intimate meeting to a full-venue buyout — tell us your headcount and we'll match you to the right room.</p>
    </div>
    <div class="spaces-grid">
      <div class="space-card space-card--photo" style="background-image:url('/assets/img/gallery/ivy-rooftop-string-lights.jpg')">
        <div class="card-inner">
          <span class="eyebrow">Private</span>
          <h3>The Ivy Rooftop</h3>
          <p>Private use of our rooftop bar. Surround yourselves with greenery while enjoying the weather and cold drinks.</p>
        </div>
      </div>
      <div class="space-card space-card--photo" style="background-image:url('/assets/img/gallery/gathering-room-tv.jpg')">
        <div class="card-inner">
          <span class="eyebrow">Semi-Private</span>
          <h3>The Gathering Room</h3>
          <p>Semi-private use of our formal dining room. Boasting a 98" TV — perfect for meetings, presentations, or draft day shenanigans.</p>
        </div>
      </div>
      <div class="space-card space-card--photo" style="background-image:url('/assets/img/gallery/ivy-room-dry-bar.jpg')">
        <div class="card-inner">
          <span class="eyebrow">Private</span>
          <h3>The Ivy Room</h3>
          <p>Private use of our dedicated event space. Equipped with a dry bar and TVs for any occasion.</p>
        </div>
      </div>
      <div class="space-card space-card--photo" style="background-image:url('/assets/img/gallery/ivy-bundle-split.jpg')">
        <div class="card-inner">
          <span class="eyebrow">Private</span>
          <h3>The Ivy Bundle</h3>
          <p>Private use of our rooftop bar and our dedicated event space.</p>
        </div>
      </div>
      <div class="space-card space-card--photo space-card--wide" style="background-image:url('/assets/img/gallery/main-bar-game-day.jpg')">
        <div class="card-inner">
          <span class="eyebrow">Full Buyout</span>
          <h3>Full Buyout</h3>
          <p>Exclusive use of the rooftop, event space, dining room &amp; main bar. Perfect for large gatherings and corporate events.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="form-section" id="inquiry">
  <div class="wrap form-wrap">
    <div class="section-head">
      <span class="eyebrow">Get Started</span>
      <h2>Tell us about your event</h2>
      <p>Fill this out and our events team will follow up within one business day.</p>
    </div>

    <form class="event-form" name="private-event-inquiry" method="POST" data-form="private-event-inquiry" data-recipient="events@theivybk.com" id="event-form">
      <div class="form-row">
        <div class="field">
          <label for="full-name">Full Name<span class="req">*</span></label>
          <input type="text" id="full-name" name="full_name" required autocomplete="name">
        </div>
        <div class="field">
          <label for="phone">Phone<span class="req">*</span></label>
          <input type="tel" id="phone" name="phone" required autocomplete="tel">
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label for="email">Email<span class="req">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email">
        </div>
        <div class="field">
          <label for="company">Company <span style="font-weight:400; text-transform:none; color:var(--fg-3);">(optional)</span></label>
          <input type="text" id="company" name="company">
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label for="event-date">Preferred Date<span class="req">*</span></label>
          <input type="date" id="event-date" name="event_date" required>
        </div>
        <div class="field">
          <label for="event-time">Preferred Time<span class="req">*</span></label>
          <select id="event-time" name="event_time" required>
            <option value="">Select a time</option>
            <option>11:00 AM</option><option>12:00 PM</option><option>1:00 PM</option>
            <option>2:00 PM</option><option>3:00 PM</option><option>4:00 PM</option>
            <option>5:00 PM</option><option>6:00 PM</option><option>7:00 PM</option>
            <option>8:00 PM</option><option>9:00 PM</option><option>10:00 PM</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label for="guest-count">Number of Guests<span class="req">*</span></label>
          <select id="guest-count" name="guest_count" required>
            <option value="">Select a range</option>
            <option>10 – 20</option><option>20 – 35</option><option>35 – 50</option>
            <option>50 – 75</option><option>75 – 100</option><option>100+</option>
          </select>
        </div>
        <div class="field">
          <label for="duration">Duration</label>
          <select id="duration" name="duration">
            <option value="">Select duration</option>
            <option>1 hour</option><option>2 hours</option><option>3 hours</option>
            <option>4 hours</option><option>Full buyout / all night</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label for="occasion">Occasion<span class="req">*</span></label>
          <select id="occasion" name="occasion" required>
            <option value="">Select an occasion</option>
            <option>Anniversary</option><option>Baby Shower</option><option>Bachelor/Bachelorette Party</option>
            <option>Bar/Bat Mitzvah</option><option>Birthday</option><option>Bridal Shower</option>
            <option>Family Reunion</option><option>Graduation</option><option>Rehearsal Dinner</option>
            <option>Reception</option><option>Retirement</option><option>Holiday Party</option>
            <option>Business/Corporate Function</option><option>Game Day Watch Party</option><option>Other</option>
          </select>
        </div>
        <div class="field">
          <label for="space">Space Preference<span class="req">*</span></label>
          <select id="space" name="space_preference" required>
            <option value="">Select a space</option>
            <option>The Ivy Room</option>
            <option>The Ivy Rooftop</option>
            <option>The Gathering Room</option>
            <option>The Ivy Bundle</option>
            <option>Full Buyout</option>
            <option>No Preference</option>
          </select>
        </div>
      </div>

      <div class="form-row single">
        <div class="field">
          <label for="budget">Budget Per Person <span style="font-weight:400; text-transform:none; color:var(--fg-3);">(optional)</span></label>
          <input type="text" id="budget" name="budget_per_person" placeholder="e.g. $40 – $60">
        </div>
      </div>

      <div class="form-row single">
        <div class="field">
          <label for="details">Tell Us More</label>
          <textarea id="details" name="details" placeholder="Menu preferences, AV needs, decorations, anything else we should know."></textarea>
        </div>
      </div>

      <div class="form-row single">
        <div class="field">
          <label for="source">How Did You Hear About Us? <span style="font-weight:400; text-transform:none; color:var(--fg-3);">(optional)</span></label>
          <select id="source" name="referral_source">
            <option value="">Select one</option>
            <option>Search Engine</option><option>Social Media</option><option>Email</option>
            <option>Word of Mouth</option><option>Existing Customer</option><option>Other</option>
          </select>
        </div>
      </div>

      <div class="submit-row">
        <button type="submit" class="btn btn--primary">Submit Inquiry</button>
        <p class="submit-note">Inquiries are sent to <a href="mailto:events@theivybk.com" style="border-bottom:1px solid var(--brass);">events@theivybk.com</a> — we'll follow up within one business day.</p>
      </div>
    </form>

    <div class="form-confirm" id="form-confirm" hidden>
      <h2>Booked.</h2>
      <p>Your inquiry is on its way to our events team at <a href="mailto:events@theivybk.com" style="border-bottom:1px solid var(--brass);">events@theivybk.com</a>. If your email client didn't open automatically, send it directly there and we'll follow up within one business day.</p>
    </div>
  </div>
</section>

<section class="why-us">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--brass-light)">Why Host Here</span>
    <h2 style="color:var(--cream); font-style:italic;">Looking for the perfect place to host your next private event?</h2>
    <p style="color:rgba(245,239,227,.85); max-width:520px;">Rent our spacious and elegant venue today.</p>
    <div class="why-grid">
      <div>
        <h3>Upscale Space, Zero Hidden Fees</h3>
        <p>What you're quoted is what you pay — no surprise add-ons when the bill comes.</p>
      </div>
      <div>
        <h3>Tiered Beverage Packages</h3>
        <p>From beer &amp; wine to a full open bar, pick the package that fits your group and budget.</p>
      </div>
      <div>
        <h3>Crowd-Pleasing Culinary Buffet</h3>
        <p>Family-style spreads built around our most-ordered pizzas, handhelds &amp; shareables.</p>
      </div>
      <div>
        <h3>Seamless Booking and Service</h3>
        <p>One point of contact from the first inquiry through the final check.</p>
      </div>
    </div>
    <p style="color:rgba(245,239,227,.6); font-size:12px; margin-top:var(--sp-7); font-family:var(--font-ui);">A 20% deposit is required to lock in your date. Taxes and a 20% gratuity apply.</p>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('event-form');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const label = (v) => v && v.trim() ? v : '—';
    const lines = [
      `Name: ${label(data.get('full_name'))}`,
      `Phone: ${label(data.get('phone'))}`,
      `Email: ${label(data.get('email'))}`,
      `Company: ${label(data.get('company'))}`,
      `Preferred Date: ${label(data.get('event_date'))}`,
      `Preferred Time: ${label(data.get('event_time'))}`,
      `Number of Guests: ${label(data.get('guest_count'))}`,
      `Duration: ${label(data.get('duration'))}`,
      `Occasion: ${label(data.get('occasion'))}`,
      `Space Preference: ${label(data.get('space_preference'))}`,
      `Budget Per Person: ${label(data.get('budget_per_person'))}`,
      `How They Heard About Us: ${label(data.get('referral_source'))}`,
      ``,
      `Details:`,
      label(data.get('details'))
    ].join('\n');

    const subject = `Private Event Inquiry — ${label(data.get('occasion'))} — ${label(data.get('full_name'))}`;
    const mailto = `mailto:${form.dataset.recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines)}`;
    window.location.href = mailto;

    form.hidden = true;
    document.getElementById('form-confirm').hidden = false;
    document.getElementById('form-confirm').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>
</Layout>

<style is:global>
  .page-hero {
    position: relative; padding: var(--sp-11) 0 var(--sp-9); text-align: center; color: var(--cream);
    background: linear-gradient(180deg, rgba(22,48,31,.55), rgba(22,48,31,.88)),
                url('/assets/img/gallery/DSC_1103.jpg') center/cover no-repeat;
  }
  .page-hero h1 { color: var(--cream); font-size: var(--fs-6xl); font-style: italic; margin-bottom: var(--sp-4); }
  .page-hero p { max-width: 560px; margin: 0 auto; color: rgba(245,239,227,.88); }

  .occasions { padding: var(--sp-9) 0; background: var(--bg-alt); }
  .occ-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-5); text-align: center; }
  .occ-grid div {
    font-family: var(--font-ui); font-size: var(--fs-xs); font-weight: 500; letter-spacing: .04em;
    padding: var(--sp-4); background: var(--bg-card); border: 1px solid var(--border-hair); border-radius: var(--r-sm);
  }

  .spaces { padding: var(--sp-11) 0; }
  .spaces-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-6); }
  .space-card {
    background: var(--bg-card); border: 1px solid var(--border-hair); border-radius: var(--r-sm);
    padding: var(--sp-7); text-align: center;
  }
  .space-card .eyebrow { display: block; margin-bottom: var(--sp-2); }
  .space-card h3 { font-size: var(--fs-xl); margin-bottom: var(--sp-3); }
  .space-card p { color: var(--fg-2); font-size: var(--fs-sm); margin: 0; }
  .space-card--wide { grid-column: 1 / -1; min-height: 260px; }
  .space-card--photo {
    padding: 0; text-align: left; overflow: hidden; position: relative; min-height: 320px;
    display: flex; align-items: flex-end;
    background-size: cover; background-position: center;
  }
  .space-card--photo::before {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(22,48,31,0) 40%, rgba(22,48,31,.88) 100%);
  }
  .space-card--photo .card-inner { position: relative; z-index: 1; padding: var(--sp-6); }
  .space-card--photo .eyebrow { color: var(--brass-light); }
  .space-card--photo h3 { color: var(--cream); }
  .space-card--photo p { color: rgba(245,239,227,.85); }
  @media (max-width: 860px) { .spaces-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .spaces-grid { grid-template-columns: 1fr; } }

  .form-section { padding: var(--sp-11) 0; }
  .form-wrap { max-width: 720px; margin: 0 auto; }
  .form-wrap .section-head { text-align: center; margin-bottom: var(--sp-8); }
  .form-wrap .section-head h2 { font-size: var(--fs-4xl); font-style: italic; }
  .form-wrap .section-head p { color: var(--fg-2); font-size: var(--fs-sm); }

  form.event-form { background: var(--bg-card); border: 1px solid var(--border-hair); border-radius: var(--r-sm); padding: var(--sp-8); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-5); margin-bottom: var(--sp-5); }
  .form-row.single { grid-template-columns: 1fr; }
  .field label {
    display: block; font-family: var(--font-ui); font-size: var(--fs-2xs); font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase; color: var(--ivy); margin-bottom: var(--sp-2);
  }
  .field .req { color: var(--brick); margin-left: 2px; }
  .field input, .field select, .field textarea {
    width: 100%; font-family: var(--font-body); font-size: var(--fs-md); color: var(--ink);
    background: var(--cream-pure); border: 1px solid var(--border-hair); border-radius: var(--r-xs);
    padding: 12px 14px; transition: border-color var(--t-fast) var(--ease-out);
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: 2px solid var(--ivy); outline-offset: 1px; border-color: var(--ivy);
  }
  .field textarea { resize: vertical; min-height: 110px; font-family: var(--font-body); }
  .field-note { font-size: 12px; color: var(--fg-3); margin-top: 4px; font-style: italic; }

  .consent-row { display: flex; align-items: flex-start; gap: 10px; margin: var(--sp-6) 0; }
  .consent-row input { margin-top: 4px; width: auto; }
  .consent-row label { font-family: var(--font-ui); font-size: 12px; color: var(--fg-2); line-height: 1.5; }
  .consent-row a { border-bottom: 1px solid var(--brass); }

  .submit-row { text-align: center; margin-top: var(--sp-7); }
  .submit-row .btn { width: 100%; justify-content: center; padding: 16px; font-size: var(--fs-sm); }
  .submit-note { text-align: center; font-size: 12px; color: var(--fg-3); margin-top: var(--sp-4); }

  .form-confirm { background: var(--bg-card); border: 1px solid var(--border-hair); border-radius: var(--r-sm); padding: var(--sp-8); text-align: center; }
  .form-confirm h2 { font-style: italic; font-size: var(--fs-4xl); }
  .form-confirm p { color: var(--fg-2); margin: 0; }

  .why-us { padding: var(--sp-9) 0; background: var(--bg-inverse); color: var(--cream); text-align: center; }
  .why-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: var(--sp-7); margin-top: var(--sp-7); text-align: left; }
  .why-grid h3 { color: var(--cream); font-size: var(--fs-xl); }
  .why-grid p { color: rgba(245,239,227,.8); font-size: var(--fs-sm); margin: 0; }

  @media (max-width: 860px) {
    .occ-grid { grid-template-columns: repeat(2,1fr); }
    .why-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .form-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .why-grid { grid-template-columns: 1fr; }
  }
</style>

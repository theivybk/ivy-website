---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["Restaurant", "BarOrPub"],
  "name": "The Ivy Bar and Kitchen",
  "url": "https://www.theivybk.com/menu",
  "telephone": "+17737998160",
  "priceRange": "$$",
  "servesCuisine": ["American", "Pizza", "Bar Food"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1625 W Irving Park Rd",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "postalCode": "60613",
    "addressCountry": "US"
  },
  "areaServed": ["Lakeview, Chicago", "Wrigleyville, Chicago", "Chicago, IL"],
  "menu": "https://www.theivybk.com/menu",
  "sameAs": [
    "https://www.instagram.com/theivybk/",
    "https://www.facebook.com/p/The-Ivy-Bar-and-Kitchen-61587359361446/"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "28"
  }
};
---
<Layout
  title="Menus | The Ivy Bar and Kitchen — Lakeview, Chicago"
  description="Full food, pizza, beer, cocktail, wine &amp; spirits menu for The Ivy Bar and Kitchen in Lakeview, Chicago — Chicago Tavern &amp; Detroit Pan pizza, smash burgers, and craft cocktails."
  ogTitle="Menus | The Ivy Bar and Kitchen"
  ogDescription="Chicago Tavern &amp; Detroit Pan pizza, smash burgers, craft cocktails and a deep spirits list — the full menu for The Ivy in Lakeview, Chicago."
  ogImage="https://www.theivybk.com/assets/img/gallery/DSC_0928.jpg"
  canonicalPath="/menu"
  jsonLd={jsonLd}
  active="menu"
  navCtaLabel="Reserve a Table"
  navCtaHref="/#reserve"
>

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">The Full Spread</span>
    <h1>Menus</h1>
    <p>Please notify your server of any allergies · 3% credit card processing fee applied to all card transactions</p>
  </div>
</section>

<nav class="tabs" id="tabs">
  <button data-tab="food" class="active">Food</button>
  <button data-tab="pizza">Pizza</button>
  <button data-tab="beer">Beer</button>
  <button data-tab="cocktails"><span class="tab-label-full">Cocktails &amp; Wine</span><span class="tab-label-short">Drinks</span></button>
  <button data-tab="spirits">Spirits</button>
  <button data-tab="kids">Kids</button>
</nav>

<!-- ══════════════════ FOOD ══════════════════ -->
<section class="panel active" id="food" data-panel>
  <svg class="panel-vine" viewBox="0 0 200 200" aria-hidden="true"><use href="#ivy-vine"></use></svg>
  <div class="wrap">
    <div class="menu-sections">

      <div class="menu-section">
        <h2>Small Plates</h2><span class="seclabel">to share, or not</span>
        <div class="item"><div class="row"><div class="name">Hummus</div><span class="leader"></span><div class="price">16</div></div>
          <div class="desc">Whipped silky, drizzled with EVOO, sumac &amp; parsley. Served with cucumbers, red bell peppers, Greek &amp; Kalamata marinated olives, roasted chickpeas &amp; warm pita</div></div>
        <div class="item"><div class="row"><div class="name">Pretzel Twist</div><span class="leader"></span><div class="price">14</div></div>
          <div class="desc">Served with whole grain mustard &amp; cheese sauce</div></div>
        <div class="item"><div class="row"><div class="name">Cheese Curds</div><span class="leader"></span><div class="price">12</div></div>
          <div class="desc">Served with spicy ranch</div></div>
        <div class="item"><div class="row"><div class="name">Fries</div><span class="leader"></span><div class="price">9</div></div>
          <div class="desc">Go truffle, topped with parmesan &amp; parsley — +1</div></div>
        <div class="item"><div class="row"><div class="name">Green Beans</div><span class="leader"></span><div class="price">11</div></div>
          <div class="desc">Blistered in lemon butter, finished with grated parmesan &amp; crispy fried onions</div></div>
        <div class="item"><div class="row"><div class="name">Brussel Sprouts</div><span class="leader"></span><div class="price">11</div></div>
          <div class="desc">Crisped in a honey-sriracha glaze, dusted with tuxedo sesame seeds</div></div>
        <div class="item"><div class="row"><div class="name">Crispy Wings</div><span class="leader"></span><div class="price">16</div></div>
          <div class="opts">BBQ · Buffalo · Butter Chicken · Giardiniera Hot Honey</div>
          <div class="desc">Served with ranch or bleu cheese</div></div>
        <div class="item"><div class="row"><div class="name">Chicken Tenders</div><span class="leader"></span><div class="price">14</div></div>
          <div class="opts">Ranch · Bleu Cheese · BBQ · Buffalo · Dijon Honey Mustard</div></div>
        <div class="item"><div class="row"><div class="name">Grilled Shrimp</div><span class="leader"></span><div class="price">16</div></div>
          <div class="desc">Cajun-garlic butter, jalapeño coleslaw tossed in agave lime vinaigrette &amp; a side of honey sriracha, garnished with parsley</div></div>
        <div class="item"><div class="row"><div class="name">Crispy Pork Belly Bites</div><span class="leader"></span><div class="price">16</div></div>
          <div class="desc">Honey sriracha glaze, agave lime vinaigrette jalapeño cole slaw</div></div>
        <div class="item"><div class="row"><div class="name">Nachos</div><span class="leader"></span><div class="price">17</div></div>
          <div class="desc">Hatch chili cheese, red onions, tomatoes, lettuce, jalapeños, black beans, guacamole, sour cream &amp; chihuahua cheese</div>
          <div class="opts">Add — Ground Beef +6 · Grilled Shrimp +8 · Steak +12 · Grilled Chicken +6 · Fried Chicken +6 · Bacon +4</div></div>
        <div class="item"><div class="row"><div class="name">Quesadilla</div><span class="leader"></span><div class="price">15</div></div>
          <div class="desc">Pico de gallo, sour cream, guacamole &amp; chihuahua cheese</div>
          <div class="opts">Add — Ground Beef +6 · Grilled Shrimp +8 · Steak +12 · Grilled Chicken +6 · Fried Chicken +6 · Bacon +4 · Black Beans +4</div></div>
        <div class="item"><div class="row"><div class="name">Mac n' Cheese</div><span class="leader"></span><div class="price">12</div></div>
          <div class="desc">Cavatappi swirls in a velvety cheese</div>
          <div class="opts">Add — Ground Beef +6 · Grilled Shrimp +8 · Steak +12 · Grilled Chicken +6 · Fried Chicken +6 · Bacon +4</div></div>
      </div>

      <div class="menu-section">
        <h2>Entrées</h2><span class="seclabel">from the kitchen</span>
        <div class="item"><div class="row"><div class="name">Pan-Seared Walleye</div><span class="leader"></span><div class="price">28</div></div>
          <div class="desc">Lemon butter, capers &amp; parsley. Served with green beans</div></div>
        <div class="item"><div class="row"><div class="name">Grilled Steak</div><span class="leader"></span><div class="price">30</div></div>
          <div class="desc">Marinated hanger steak, chimichurri. Served with brussels sprouts</div></div>
      </div>

      <div class="menu-section">
        <h2>Salads</h2><span class="seclabel">crisp, simple, generous</span>
        <p class="item desc" style="font-size:12px;">Add a protein — Grilled Shrimp +8 · Steak +12 · Grilled Chicken +6 · Fried Chicken +6 · Bacon +4</p>
        <div class="item"><div class="row"><div class="name">Caesar</div><span class="leader"></span><div class="price">18</div></div>
          <div class="desc">Crisp romaine, house croutons &amp; parmesan · grilled or fried chicken — buffalo on either</div></div>
        <div class="item"><div class="row"><div class="name">House Salad</div><span class="leader"></span><div class="price">17</div></div>
          <div class="desc">Mixed greens, onions, grape tomatoes, shredded carrots, agave lime vinaigrette</div></div>
        <div class="item"><div class="row"><div class="name">Crispy Chicken Chopped</div><span class="leader"></span><div class="price">21</div></div>
          <div class="desc">Crisp romaine, avocado, bacon, tomatoes, red onions &amp; bleu cheese dressing</div></div>
        <div class="item"><div class="row"><div class="name">Summer Salad</div><span class="leader"></span><div class="price">20</div></div>
          <div class="desc">Mixed greens tossed with sweet strawberries, grape tomatoes &amp; red onion, crumbled feta &amp; toasted almonds in a honey-lemon vinaigrette</div></div>
      </div>

      <div class="menu-section">
        <h2>Handhelds</h2><span class="seclabel">served with fries</span>
        <p class="item desc" style="font-size:12px;">Go truffle +1 · Gluten-free bun available · Sub a vegetarian Beyond patty</p>
        <div class="item"><div class="row"><div class="name">The Original</div><span class="leader"></span><div class="price">20</div></div>
          <div class="desc">Two smash patties, house sauce, pickles, caramelized onions &amp; white American cheese, potato bun</div></div>
        <div class="item"><div class="row"><div class="name">Five Alarm</div><span class="leader"></span><div class="price">20</div></div>
          <div class="desc">Two smash patties, house sauce, pickles, caramelized onions, jalapeños &amp; pepper jack, potato bun</div></div>
        <div class="item"><div class="row"><div class="name">The Works</div><span class="leader"></span><div class="price">20</div></div>
          <div class="desc">Two smash patties, house sauce, pickles, onions, tomatoes, lettuce &amp; white American cheese, potato bun</div></div>
        <div class="item"><div class="row"><div class="name">Southwest Grilled Chicken</div><span class="leader"></span><div class="price">20</div></div>
          <div class="desc">Guacamole, lettuce, tomatoes, red onions &amp; chipotle mayo, brioche bun</div></div>
        <div class="item"><div class="row"><div class="name">Steak Sandwich</div><span class="leader"></span><div class="price">25</div></div>
          <div class="desc">Hanger steak, chimichurri, provolone, caramelized onions, ciabatta</div></div>
        <div class="item"><div class="row"><div class="name">Caesar Wrap</div><span class="leader"></span><div class="price">20</div></div>
          <div class="desc">Crisp romaine, house caesar, croutons &amp; parmesan · grilled or fried chicken</div></div>
      </div>

      <div class="menu-section">
        <h2>Dessert</h2><span class="seclabel">a sweet finish</span>
        <div class="item"><div class="row"><div class="name">Cheesecake</div><span class="leader"></span><div class="price">12</div></div>
          <div class="desc">Raspberry &amp; blackberry compote</div></div>
        <div class="item"><div class="row"><div class="name">Gelato</div><span class="leader"></span><div class="price">7</div></div>
          <div class="desc">Vanilla bean, strawberry cheesecake, double dark chocolate or mango sorbet</div></div>
        <div class="item"><div class="row"><div class="name">Gelato Trio</div><span class="leader"></span><div class="price">15</div></div>
          <div class="desc">Choose three</div></div>
      </div>

    </div>
  </div>
</section>

<!-- ══════════════════ PIZZA ══════════════════ -->
<section class="panel" id="pizza" data-panel>
  <svg class="panel-vine" viewBox="0 0 200 200" aria-hidden="true"><use href="#ivy-vine"></use></svg>
  <div class="wrap">
    <div class="menu-sections">
      <div class="menu-section">
        <h2>From the Oven</h2><span class="seclabel">to start</span>
        <div class="item"><div class="row"><div class="name">Garlic Bread</div><span class="leader"></span><div class="price">14</div></div></div>
        <div class="item"><div class="row"><div class="name">Cheesy Garlic Bread</div><span class="leader"></span><div class="price">16</div></div></div>
      </div>
      <div class="menu-section">
        <h2>Chicago Tavern</h2><span class="seclabel">thin, crisp · 12" × 12"</span>
        <div class="item"><div class="row"><div class="name">Chi-City GOAT</div><span class="leader"></span><div class="price">28</div></div><div class="desc">Italian sausage, giardiniera</div></div>
        <div class="item"><div class="row"><div class="name">Red Ivy</div><span class="leader"></span><div class="price">27</div></div><div class="desc">Pepperoni, hot honey</div></div>
        <div class="item"><div class="row"><div class="name">Fowl Play</div><span class="leader"></span><div class="price">28</div></div><div class="desc">Chicken sausage, BBQ sauce, green pepper, caramelized onions</div></div>
        <div class="item"><div class="row"><div class="name">White Out</div><span class="leader"></span><div class="price">28</div></div><div class="desc">Olive oil, ricotta, spinach, mushrooms, green olives, garlic</div></div>
      </div>
      <div class="menu-section">
        <h2>Detroit Pan</h2><span class="seclabel">golden crust, crisp corners · 8" × 10"</span>
        <div class="item"><div class="row"><div class="name">The Standard 313</div><span class="leader"></span><div class="price">19</div></div><div class="desc">Cheese, tomato sauce</div></div>
        <div class="item"><div class="row"><div class="name">Pep In Your Step</div><span class="leader"></span><div class="price">25</div></div><div class="desc">Pepperoni and pepperoni — with some pepperoni on top</div></div>
        <div class="item"><div class="row"><div class="name">The Bad Boys 5</div><span class="leader"></span><div class="price">25</div></div><div class="desc">Italian sausage, jalapeños, mushrooms, caramelized onions, basil</div></div>
        <div class="item"><div class="row"><div class="name">Green Assembly Line</div><span class="leader"></span><div class="price">23</div></div><div class="desc">Green peppers, mushrooms, red onions, black olives</div></div>
      </div>
      <div class="menu-section" style="grid-column: 1 / -1;">
        <h2>Build Your Own</h2><span class="seclabel">draft your line-up</span>
        <p style="text-align:center; font-style:italic; color:var(--fg-2); font-size: var(--fs-sm);">Pick a crust, choose a sauce, then add up to five toppings</p>
        <div class="byo-grid">
          <div><h3>I. Crust</h3><ul><li>Tavern 12"×12" <span>22</span></li><li>Detroit 8"×10" <span>19</span></li></ul></div>
          <div><h3>II. Sauce</h3><ul><li>Tomato</li><li>BBQ</li><li>Olive Oil</li></ul></div>
          <div><h3>III. Meats +5</h3><ul><li>Italian Sausage</li><li>Pepperoni</li><li>Chicken Sausage</li><li>Bacon</li></ul></div>
        </div>
        <h3 style="text-align:center; font-family:var(--font-ui); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--ivy); border-bottom:1px solid var(--border-hair); padding-bottom:6px; margin-top:var(--sp-6);">IV. Toppings +3</h3>
        <ul class="toppings-list">
          <li>Green Peppers</li><li>Mushrooms</li><li>Red Onions</li><li>Caramelized Onions</li>
          <li>Black Olives</li><li>Green Olives</li><li>Fresh Jalapeños</li><li>Giardiniera</li>
          <li>Spinach</li><li>Garlic</li><li>Basil</li><li>Ricotta Dollops</li><li>Butter Chicken</li>
        </ul>
      </div>
    </div>
    <p class="menu-footnote">Specialty pizzas are served as listed — no additions, though feel free to leave anything off · 20% gratuity on parties of six or more</p>
  </div>
</section>

<!-- ══════════════════ BEER ══════════════════ -->
